# Vyntra Server Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL connection pooler and direct URL)
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-example.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Auth & Session
JWT_SECRET="vyntra_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Client & Server URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# Daily Quota Timezone
QUOTA_TIMEZONE="Asia/Kolkata"

# Storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET="vyntra-media"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Translation Provider
TRANSLATION_PROVIDER="built-in"

# Multi-Source Video Discovery & Content Aggregation
YOUTUBE_API_KEY="your_youtube_data_api_v3_key"
NASA_API_KEY="your_nasa_open_api_key"
